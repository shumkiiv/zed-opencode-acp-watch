shutdown = threading.Event()


def now_ms():
    return int(time.time() * 1000)


def log(message, **fields):
    try:
        Path(LOG_PATH).parent.mkdir(parents=True, exist_ok=True)
        row = {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "message": message,
            **fields,
        }
        with log_lock:
            with open(LOG_PATH, "a", encoding="utf-8") as fh:
                fh.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")
    except Exception:
        pass


def acquire_start_lock():
    try:
        Path(START_LOCK_PATH).parent.mkdir(parents=True, exist_ok=True)
        lock_file = open(START_LOCK_PATH, "w", encoding="utf-8")
        deadline = time.monotonic() + START_LOCK_TIMEOUT_SEC
        waited = 0.0
        while True:
            try:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                log("start_lock_acquired", waited=round(waited, 2), path=START_LOCK_PATH)
                return lock_file
            except BlockingIOError:
                if START_LOCK_TIMEOUT_SEC <= 0 or time.monotonic() >= deadline:
                    log("start_lock_timeout", waited=round(waited, 2), path=START_LOCK_PATH)
                    lock_file.close()
                    return None
                time.sleep(0.1)
                waited += 0.1
    except Exception as exc:
        log("start_lock_error", error=str(exc), path=START_LOCK_PATH)
        return None


def release_start_lock(lock_file):
    if not lock_file:
        return
    try:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
        log("start_lock_released", path=START_LOCK_PATH)
    except Exception as exc:
        log("start_lock_release_error", error=str(exc), path=START_LOCK_PATH)
    try:
        lock_file.close()
    except Exception:
        pass


def parse_line(raw):
    try:
        return json.loads(raw.decode("utf-8"))
    except Exception:
        return None


def write_line(raw):
    with write_lock:
        sys.stdout.buffer.write(raw)
        if not raw.endswith(b"\n"):
            sys.stdout.buffer.write(b"\n")
        sys.stdout.buffer.flush()


def write_json(payload):
    write_line((json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8"))


def method_name(message):
    method = message.get("method")
    return method if isinstance(method, str) else ""


def request_id(message):
    value = message.get("id")
    if isinstance(value, (str, int)):
        return value
    return None


def params_obj(message):
    params = message.get("params")
    return params if isinstance(params, dict) else {}


def extract_session_id_from_prompt(message):
    params = params_obj(message)
    for key in ("sessionId", "sessionID", "session_id"):
        value = params.get(key)
        if isinstance(value, str) and value:
            return value
    session = params.get("session")
    if isinstance(session, dict):
        for key in ("id", "sessionId", "sessionID"):
            value = session.get(key)
            if isinstance(value, str) and value:
                return value
    return None


def extract_session_id_from_cancel(message):
    params = params_obj(message)
    for key in ("sessionId", "sessionID", "session_id", "id"):
        value = params.get(key)
        if isinstance(value, str) and value:
            return value
    return None


def active_descendant_count(session_id):
    cutoff = now_ms() - ACTIVE_WINDOW_SEC * 1000
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=1)
        conn.execute("pragma query_only=ON")
        query = """
        with recursive tree(id) as (
          values(?)
          union
          select s.id from session s join tree t on s.parent_id = t.id
        )
        select
          (
            select count(*)
            from part p
            join tree t on t.id = p.session_id
            where json_extract(p.data, '$.type') = 'tool'
              and json_extract(p.data, '$.state.status') in ('pending', 'running')
              and p.time_updated >= ?
          ) as active_tools,
          (
            select count(*)
            from message m
            join tree t on t.id = m.session_id
            where json_extract(m.data, '$.role') = 'assistant'
              and json_extract(m.data, '$.time.completed') is null
              and m.time_updated >= ?
          ) as active_messages
        """
        row = conn.execute(query, (session_id, cutoff, cutoff)).fetchone()
        conn.close()
        if not row:
            return 0
        return int(row[0] or 0) + int(row[1] or 0)
    except Exception as exc:
        log("db_status_error", session_id=session_id, error=str(exc))
        return 0


def descendant_activity_summary(session_id):
    active_cutoff = now_ms() - ACTIVE_WINDOW_SEC * 1000
    recent_cutoff = now_ms() - STATUS_RECENT_WINDOW_SEC * 1000
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=1)
        conn.execute("pragma query_only=ON")
        query = """
        with recursive tree(id) as (
          values(?)
          union
          select s.id from session s join tree t on s.parent_id = t.id
        )
        select
          (
            select count(*)
            from part p
            join tree t on t.id = p.session_id
            where json_extract(p.data, '$.type') = 'tool'
              and json_extract(p.data, '$.state.status') in ('pending', 'running')
              and p.time_updated >= ?
          ) as active_tools,
          (
            select count(*)
            from message m
            join tree t on t.id = m.session_id
            where json_extract(m.data, '$.role') = 'assistant'
              and json_extract(m.data, '$.time.completed') is null
              and m.time_updated >= ?
          ) as active_messages,
          (
            select count(*)
            from session s
            join tree t on t.id = s.id
            where s.time_updated >= ?
          ) as recent_sessions,
          (
            select count(*)
            from part p
            join tree t on t.id = p.session_id
            where p.time_updated >= ?
          ) as recent_parts,
          (
            select s.title
            from session s
            join tree t on t.id = s.id
            order by s.time_updated desc
            limit 1
          ) as latest_title,
          (
            select s.time_updated
            from session s
            join tree t on t.id = s.id
            order by s.time_updated desc
            limit 1
          ) as latest_session_updated,
          (
            select max(updated)
            from (
              select max(s.time_updated) as updated
              from session s
              join tree t on t.id = s.id
              union all
              select max(p.time_updated) as updated
              from part p
              join tree t on t.id = p.session_id
              union all
              select max(m.time_updated) as updated
              from message m
              join tree t on t.id = m.session_id
            )
          ) as latest_activity_updated,
          (
            select json_extract(p.data, '$.tool')
            from part p
            join tree t on t.id = p.session_id
            where json_extract(p.data, '$.type') = 'tool'
            order by p.time_updated desc
            limit 1
          ) as latest_tool,
          (
            select json_extract(p.data, '$.state.status')
            from part p
            join tree t on t.id = p.session_id
            where json_extract(p.data, '$.type') = 'tool'
            order by p.time_updated desc
            limit 1
          ) as latest_tool_status
        """
        row = conn.execute(
            query,
            (session_id, active_cutoff, active_cutoff, recent_cutoff, recent_cutoff),
        ).fetchone()
        conn.close()
        if not row:
            return {
                "active": 0,
                "recent": 0,
                "active_tools": 0,
                "active_messages": 0,
                "recent_sessions": 0,
                "recent_parts": 0,
                "latest_title": "",
                "latest_age": None,
                "latest_session_updated": None,
                "latest_activity_updated": None,
                "latest_tool": "",
                "latest_tool_status": "",
            }
        active_tools = int(row[0] or 0)
        active_messages = int(row[1] or 0)
        recent_sessions = int(row[2] or 0)
        recent_parts = int(row[3] or 0)
        latest_session_updated = int(row[5] or 0)
        latest_activity_updated = int(row[6] or latest_session_updated or 0)
        latest_age = max(0, int((now_ms() - latest_activity_updated) / 1000)) if latest_activity_updated else None
        return {
            "active": active_tools + active_messages,
            "recent": recent_sessions + recent_parts,
            "active_tools": active_tools,
            "active_messages": active_messages,
            "recent_sessions": recent_sessions,
            "recent_parts": recent_parts,
            "latest_title": row[4] or "",
            "latest_age": latest_age,
            "latest_session_updated": latest_session_updated or None,
            "latest_activity_updated": latest_activity_updated or None,
            "latest_tool": row[7] or "",
            "latest_tool_status": row[8] or "",
        }
    except Exception as exc:
        log("db_activity_error", session_id=session_id, error=str(exc))
        return {
            "active": 0,
            "recent": 0,
            "active_tools": 0,
            "active_messages": 0,
            "recent_sessions": 0,
            "recent_parts": 0,
            "latest_title": "",
            "latest_age": None,
            "latest_session_updated": None,
            "latest_activity_updated": None,
            "latest_tool": "",
            "latest_tool_status": "",
        }


def activity_title(summary):
    latest_age = summary.get("latest_age")
    age_text = f", последнее обновление {latest_age} с назад" if latest_age is not None else ""
    return (
        "OpenCode активен: "
        f"инструменты {summary.get('active_tools', 0)}, "
        f"сообщения {summary.get('active_messages', 0)}, "
        f"свежая активность {summary.get('recent', 0)}{age_text}"
    )


def format_gib_from_kb(value_kb):
    if value_kb is None:
        return "?"
    value_gib = value_kb / 1024 / 1024
    if value_gib < 10:
        return f"{value_gib:.1f}G"
    return f"{value_gib:.0f}G"


def format_compact_count(value):
    value = int(value or 0)
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M"
    if value >= 10_000:
        return f"{value / 1_000:.0f}K"
    if value >= 1_000:
        return f"{value / 1_000:.1f}K"
    return str(value)


def format_duration_sec(value):
    value = int(value or 0)
    if value >= 48 * 60 * 60:
        return f"{value / 86400:.0f} д"
    if value >= 60 * 60:
        return f"{value / 3600:.0f} ч"
    if value >= 60:
        return f"{value / 60:.0f} мин"
    return f"{value} с"


def read_load_summary():
    try:
        with open("/proc/loadavg", "r", encoding="utf-8") as fh:
            load1 = float(fh.read().split()[0])
    except Exception:
        load1 = None
    cpus = os.cpu_count() or 1
    return load1, cpus


def read_memory_summary():
    values = {}
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as fh:
            for line in fh:
                key, raw_value = line.split(":", 1)
                parts = raw_value.strip().split()
                if parts:
                    values[key] = int(parts[0])
    except Exception as exc:
        log("preflight_meminfo_error", error=str(exc))
    mem_available = values.get("MemAvailable")
    swap_total = values.get("SwapTotal")
    swap_free = values.get("SwapFree")
    swap_used = None
    if swap_total is not None and swap_free is not None:
        swap_used = max(0, swap_total - swap_free)
    return mem_available, swap_used, swap_total


def count_opencode_acp_processes():
    count = 0
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                raw = Path("/proc") / entry / "cmdline"
                parts = raw.read_bytes().split(b"\0")
            except Exception:
                continue
            if not parts or not parts[0]:
                continue
            executable = os.path.basename(parts[0].decode("utf-8", "ignore"))
            if executable == "opencode" and any(part == b"acp" for part in parts[1:]):
                count += 1
    except Exception as exc:
        log("preflight_process_scan_error", error=str(exc))
    return count


def preflight_queue_summary(session_id):
    active_cutoff = now_ms() - ACTIVE_WINDOW_SEC * 1000
    recent_cutoff = now_ms() - STATUS_RECENT_WINDOW_SEC * 1000
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=PREFLIGHT_DB_TIMEOUT_SEC)
        conn.execute("pragma query_only=ON")
        query = """
        with recursive tree(id) as (
          values(?)
          union
          select s.id from session s join tree t on s.parent_id = t.id
        )
        select
          (
            select count(*)
            from part p
            join tree t on t.id = p.session_id
            where json_extract(p.data, '$.type') = 'tool'
              and json_extract(p.data, '$.state.status') in ('pending', 'running')
              and p.time_updated >= ?
          ) as active_tools,
          (
            select count(*)
            from message m
            join tree t on t.id = m.session_id
            where json_extract(m.data, '$.role') = 'assistant'
              and json_extract(m.data, '$.time.completed') is null
              and m.time_updated >= ?
          ) as active_messages,
          (
            select count(*)
            from session s
            join tree t on t.id = s.id
            where s.time_updated >= ?
          ) as recent_sessions,
          (
            select count(*)
            from part p
            join tree t on t.id = p.session_id
            where p.time_updated >= ?
          ) as recent_parts
          ,
          (
            select count(*)
            from todo td
            join tree t on t.id = td.session_id
            where td.status in ('pending', 'in_progress')
          ) as open_todos
        """
        row = conn.execute(
            query,
            (session_id, active_cutoff, active_cutoff, recent_cutoff, recent_cutoff),
        ).fetchone()
        conn.close()
        if not row:
            return {"active_tools": 0, "active_messages": 0, "recent": 0, "open_todos": 0}
        return {
            "active_tools": int(row[0] or 0),
            "active_messages": int(row[1] or 0),
            "recent": int(row[2] or 0) + int(row[3] or 0),
            "open_todos": int(row[4] or 0),
        }
    except Exception as exc:
        log("preflight_queue_error", session_id=session_id, error=str(exc))
        return {"active_tools": None, "active_messages": None, "recent": None, "open_todos": None}


def find_handoff_file(directory):
    if not directory:
        return None
    try:
        base = Path(directory)
        for relative_path in CONTEXT_HANDOFF_FILES:
            candidate = base / relative_path
            if candidate.is_file():
                try:
                    size_bytes = candidate.stat().st_size
                except Exception:
                    size_bytes = None
                return {
                    "path": str(candidate),
                    "relative_path": relative_path,
                    "size_bytes": size_bytes,
                }
    except Exception as exc:
        log("preflight_context_file_error", directory=directory, error=str(exc))
    return None


def context_risk(summary):
    heavy_reasons = []
    warn_reasons = []

    input_tokens = int(summary.get("tokens_input") or 0)
    message_count = int(summary.get("message_count") or 0)
    part_count = int(summary.get("part_count") or 0)
    tool_part_count = int(summary.get("tool_part_count") or 0)
    age_sec = int(summary.get("age_sec") or 0)

    if input_tokens >= CONTEXT_INPUT_HEAVY_TOKENS:
        heavy_reasons.append(f"input {format_compact_count(input_tokens)}")
    elif input_tokens >= CONTEXT_INPUT_WARN_TOKENS:
        warn_reasons.append(f"input {format_compact_count(input_tokens)}")

    if part_count >= CONTEXT_PART_HEAVY_COUNT:
        heavy_reasons.append(f"частей {format_compact_count(part_count)}")
    elif part_count >= CONTEXT_PART_WARN_COUNT:
        warn_reasons.append(f"частей {format_compact_count(part_count)}")

    if tool_part_count >= CONTEXT_TOOL_HEAVY_COUNT:
        heavy_reasons.append(f"инструментов {format_compact_count(tool_part_count)}")
    elif tool_part_count >= CONTEXT_TOOL_WARN_COUNT:
        warn_reasons.append(f"инструментов {format_compact_count(tool_part_count)}")

    if message_count >= CONTEXT_MESSAGE_HEAVY_COUNT:
        heavy_reasons.append(f"сообщений {format_compact_count(message_count)}")
    elif message_count >= CONTEXT_MESSAGE_WARN_COUNT:
        warn_reasons.append(f"сообщений {format_compact_count(message_count)}")

    if age_sec >= CONTEXT_AGE_WARN_SEC:
        warn_reasons.append(f"возраст {format_duration_sec(age_sec)}")

    if heavy_reasons:
        return "heavy", ", ".join(heavy_reasons[:2])
    if warn_reasons:
        return "watch", ", ".join(warn_reasons[:2])
    return "ok", ""


def preflight_context_summary(session_id):
    if not CONTEXT_WARN_ENABLED:
        return {"risk": "disabled"}
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=PREFLIGHT_DB_TIMEOUT_SEC)
        conn.execute("pragma query_only=ON")
        query = """
        with recursive tree(id) as (
          values(?)
          union
          select s.id from session s join tree t on s.parent_id = t.id
        ),
        root as (
          select directory from session where id = ?
        )
        select
          (select directory from root) as directory,
          min(s.time_created) as created,
          max(s.time_updated) as updated,
          count(*) as session_count,
          coalesce(sum(s.tokens_input), 0) as tokens_input,
          coalesce(sum(s.tokens_output), 0) as tokens_output,
          coalesce(sum(s.tokens_reasoning), 0) as tokens_reasoning,
          coalesce(sum(s.tokens_cache_read), 0) as tokens_cache_read,
          coalesce(sum(s.tokens_cache_write), 0) as tokens_cache_write,
          (
            select count(*)
            from message m
            join tree t on t.id = m.session_id
          ) as message_count,
          (
            select count(*)
            from part p
            join tree t on t.id = p.session_id
          ) as part_count,
          (
            select count(*)
            from part p
            join tree t on t.id = p.session_id
            where json_extract(p.data, '$.type') = 'tool'
          ) as tool_part_count
        from session s
        join tree t on t.id = s.id
        """
        row = conn.execute(query, (session_id, session_id)).fetchone()
        conn.close()
        if not row:
            return {"risk": "unknown"}
        (
            directory,
            created,
            updated,
            session_count,
            tokens_input,
            tokens_output,
            tokens_reasoning,
            tokens_cache_read,
            tokens_cache_write,
            message_count,
            part_count,
            tool_part_count,
        ) = row
        age_sec = max(0, int((now_ms() - int(created or 0)) / 1000)) if created else 0
        handoff = find_handoff_file(directory)
        summary = {
            "directory": directory,
            "created_ms": int(created or 0),
            "updated_ms": int(updated or 0),
            "age_sec": age_sec,
            "session_count": int(session_count or 0),
            "tokens_input": int(tokens_input or 0),
            "tokens_output": int(tokens_output or 0),
            "tokens_reasoning": int(tokens_reasoning or 0),
            "tokens_cache_read": int(tokens_cache_read or 0),
            "tokens_cache_write": int(tokens_cache_write or 0),
            "message_count": int(message_count or 0),
            "part_count": int(part_count or 0),
            "tool_part_count": int(tool_part_count or 0),
            "handoff_file": handoff,
        }
        risk, reason = context_risk(summary)
        summary["risk"] = risk
        summary["reason"] = reason
        return summary
    except Exception as exc:
        log("preflight_context_error", session_id=session_id, error=str(exc))
        return {"risk": "unknown", "error": str(exc)}


def estimate_eta(load1, cpus, mem_available, swap_used, acp_count, queue, context):
    queue_unknown = queue.get("active_tools") is None or queue.get("active_messages") is None
    active_tools = int(queue.get("active_tools") or 0)
    active_messages = int(queue.get("active_messages") or 0)
    active = active_tools + active_messages
    recent = queue.get("recent")
    open_todos = queue.get("open_todos")
    open_todos_count = int(open_todos or 0)
    acp_count = int(acp_count or 0)
    load_ratio = load1 / cpus if load1 is not None and cpus else None
    low_ram = mem_available is not None and mem_available < 2 * 1024 * 1024
    memory_pressure = (
        swap_used is not None
        and swap_used > 1024 * 1024
        and mem_available is not None
        and mem_available < 4 * 1024 * 1024
    )
    context_state = context.get("risk") if isinstance(context, dict) else None

    if memory_pressure:
        return {
            "eta_label": "10+ мин",
            "eta_min_sec": 600,
            "eta_max_sec": None,
            "eta_reason": "давление по памяти",
        }
    if low_ram:
        return {
            "eta_label": "10+ мин",
            "eta_min_sec": 600,
            "eta_max_sec": None,
            "eta_reason": "мало свободной RAM",
        }
    if context_state == "heavy":
        return {
            "eta_label": "10+ мин",
            "eta_min_sec": 600,
            "eta_max_sec": None,
            "eta_reason": "тяжёлый контекст сессии",
        }
    if active >= 3:
        return {
            "eta_label": "10+ мин",
            "eta_min_sec": 600,
            "eta_max_sec": None,
            "eta_reason": "в сессии уже много активных задач",
        }
    if open_todos_count >= 5:
        return {
            "eta_label": "10+ мин",
            "eta_min_sec": 600,
            "eta_max_sec": None,
            "eta_reason": "в сессии много открытых пунктов плана",
        }
    if acp_count >= 5:
        return {
            "eta_label": "10+ мин",
            "eta_min_sec": 600,
            "eta_max_sec": None,
            "eta_reason": "много параллельных ACP-сессий",
        }
    if active > 0:
        return {
            "eta_label": "3-10 мин",
            "eta_min_sec": 180,
            "eta_max_sec": 600,
            "eta_reason": "в сессии уже есть активные задачи",
        }
    if open_todos_count >= 2:
        return {
            "eta_label": "3-10 мин",
            "eta_min_sec": 180,
            "eta_max_sec": 600,
            "eta_reason": "в сессии есть очередь todo",
        }
    if context_state == "watch":
        return {
            "eta_label": "3-10 мин",
            "eta_min_sec": 180,
            "eta_max_sec": 600,
            "eta_reason": "контекст сессии растёт",
        }
    if acp_count >= 3:
        return {
            "eta_label": "3-10 мин",
            "eta_min_sec": 180,
            "eta_max_sec": 600,
            "eta_reason": "несколько ACP-сессий уже работают",
        }
    if load_ratio is not None and load_ratio >= 0.9:
        return {
            "eta_label": "3-10 мин",
            "eta_min_sec": 180,
            "eta_max_sec": 600,
            "eta_reason": "CPU сильно занят",
        }
    if isinstance(recent, int) and recent > 0:
        return {
            "eta_label": "1-3 мин",
            "eta_min_sec": 60,
            "eta_max_sec": 180,
            "eta_reason": "есть свежая активность рядом",
        }
    if acp_count >= 2:
        return {
            "eta_label": "1-3 мин",
            "eta_min_sec": 60,
            "eta_max_sec": 180,
            "eta_reason": "есть параллельная ACP-сессия",
        }
    if queue_unknown:
        return {
            "eta_label": "1-3 мин",
            "eta_min_sec": 60,
            "eta_max_sec": 180,
            "eta_reason": "очередь не удалось быстро прочитать",
        }
    if load_ratio is not None and load_ratio >= 0.5:
        return {
            "eta_label": "1-3 мин",
            "eta_min_sec": 60,
            "eta_max_sec": 180,
            "eta_reason": "CPU умеренно занят",
        }
    return {
        "eta_label": "1-3 мин",
        "eta_min_sec": 60,
        "eta_max_sec": 180,
        "eta_reason": "минимальная оценка после прошлых замеров",
    }


def build_preflight_sample(session_id, prompt_start_ms):
    load1, cpus = read_load_summary()
    mem_available, swap_used, swap_total = read_memory_summary()
    queue_summary = preflight_queue_summary(session_id)
    acp_count = count_opencode_acp_processes()
    context_summary = preflight_context_summary(session_id)
    eta = estimate_eta(load1, cpus, mem_available, swap_used, acp_count, queue_summary, context_summary)
    load_ratio = load1 / cpus if load1 is not None and cpus else None
    return {
        "session_id": session_id,
        "prompt_start_ms": prompt_start_ms,
        "created_ms": now_ms(),
        **eta,
        "features": {
            "load1": round(load1, 2) if load1 is not None else None,
            "cpu_count": cpus,
            "load_ratio": round(load_ratio, 4) if load_ratio is not None else None,
            "mem_available_kb": mem_available,
            "swap_used_kb": swap_used,
            "swap_total_kb": swap_total,
            "opencode_acp_processes": acp_count,
            "active_tools": queue_summary.get("active_tools"),
            "active_messages": queue_summary.get("active_messages"),
            "recent": queue_summary.get("recent"),
            "open_todos": queue_summary.get("open_todos"),
            "context": context_summary,
        },
    }


def build_context_warning_text(context):
    if not isinstance(context, dict):
        return None
    risk = context.get("risk")
    if risk not in ("watch", "heavy"):
        return None
    reason = context.get("reason") or "много истории"
    handoff = context.get("handoff_file") or {}
    handoff_name = handoff.get("relative_path") if isinstance(handoff, dict) else None
    if risk == "heavy":
        prefix = "контекст тяжёлый"
    else:
        prefix = "контекст растёт"
    if handoff_name:
        suffix = f"лучше новая сессия с {handoff_name}"
    else:
        suffix = "обновите AI_CONTEXT.md и начните новую сессию"
    return f"{prefix} ({reason}); {suffix}"


def build_preflight_title(sample):
    features = sample.get("features", {})
    load1 = features.get("load1")
    cpus = features.get("cpu_count") or "?"
    mem_available = features.get("mem_available_kb")
    swap_used = features.get("swap_used_kb")
    swap_total = features.get("swap_total_kb")
    acp_count = features.get("opencode_acp_processes")
    load_text = f"{load1:.1f}/{cpus}" if isinstance(load1, (int, float)) else f"?/{cpus}"
    ram_text = format_gib_from_kb(mem_available)
    if swap_used is None or swap_total is None:
        swap_text = "?"
    else:
        swap_text = f"{format_gib_from_kb(swap_used)}/{format_gib_from_kb(swap_total)}"
    if features.get("active_tools") is None:
        queue_text = "неизвестна"
    else:
        queue_text = (
            f"инструменты {features.get('active_tools', 0)}, "
            f"сообщения {features.get('active_messages', 0)}, "
            f"todo {features.get('open_todos', 0)}"
        )
    context_warning = build_context_warning_text(features.get("context"))
    context_text = f"; {context_warning}" if context_warning else ""
    return (
        f"OpenCode перед стартом: CPU {load_text}, RAM свободно {ram_text}, "
        f"swap {swap_text}, ACP {acp_count}, очередь: {queue_text}; "
        f"оценка {sample.get('eta_label')}, причина: {sample.get('eta_reason')}"
        f"{context_text}"
    )


def eta_hit(sample, elapsed_sec):
    min_sec = sample.get("eta_min_sec")
    max_sec = sample.get("eta_max_sec")
    if min_sec is None:
        return None
    if elapsed_sec < min_sec:
        return False
    if max_sec is None:
        return True
    return elapsed_sec <= max_sec


def write_eta_stats(sample, outcome, elapsed_sec, saw_activity, extra=None):
    if not ETA_STATS_ENABLED or not sample:
        return
    try:
        row = {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "session_id": sample.get("session_id"),
            "prompt_start_ms": sample.get("prompt_start_ms"),
            "outcome": outcome,
            "elapsed_sec": round(elapsed_sec, 2),
            "eta_label": sample.get("eta_label"),
            "eta_min_sec": sample.get("eta_min_sec"),
            "eta_max_sec": sample.get("eta_max_sec"),
            "eta_reason": sample.get("eta_reason"),
            "eta_hit": eta_hit(sample, elapsed_sec),
            "saw_activity": saw_activity,
            "features": sample.get("features", {}),
        }
        if extra:
            row["extra"] = extra
        Path(ETA_STATS_PATH).parent.mkdir(parents=True, exist_ok=True)
        with eta_stats_lock:
            with open(ETA_STATS_PATH, "a", encoding="utf-8") as fh:
                fh.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")
        log(
            "eta_stats_recorded",
            session_id=sample.get("session_id"),
            outcome=outcome,
            elapsed=round(elapsed_sec, 2),
            eta=sample.get("eta_label"),
            hit=row["eta_hit"],
        )
    except Exception as exc:
        log("eta_stats_error", session_id=sample.get("session_id"), error=str(exc))


def send_preflight_status(session_id, prompt_start_ms):
    if not PREFLIGHT_ENABLED:
        return None
    try:
        sample = build_preflight_sample(session_id, prompt_start_ms)
        title = build_preflight_title(sample)
        send_tool_call(session_id, 0, title)
        log(
            "preflight_status",
            session_id=session_id,
            title=title,
            eta=sample.get("eta_label"),
            eta_reason=sample.get("eta_reason"),
            context_risk=(sample.get("features", {}).get("context") or {}).get("risk"),
        )
        return sample
    except Exception as exc:
        log("preflight_status_error", session_id=session_id, error=str(exc))
        return None


def missing_final_report_title(session_id, since_ms):
    cutoff = since_ms or (now_ms() - ACTIVE_WINDOW_SEC * 1000)
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=1)
        conn.execute("pragma query_only=ON")
        query = """
        select
          m.id,
          m.time_updated,
          json_extract(m.data, '$.finish') as finish,
          json_extract(m.data, '$.time.completed') as completed,
          (
            select count(*)
            from part p
            where p.message_id = m.id
              and json_extract(p.data, '$.type') = 'text'
              and length(trim(coalesce(json_extract(p.data, '$.text'), ''))) > 0
          ) as text_parts
        from message m
        where m.session_id = ?
          and json_extract(m.data, '$.role') = 'assistant'
          and m.time_updated >= ?
        order by m.time_updated desc
        limit 1
        """
        row = conn.execute(query, (session_id, cutoff)).fetchone()
        conn.close()
        if not row:
            return None
        message_id, updated, finish, completed, text_parts = row
        if completed is None or int(text_parts or 0) > 0:
            return None
        finish_text = finish or "unknown"
        age = max(0, int((now_ms() - int(updated or 0)) / 1000)) if updated else None
        log(
            "missing_final_report_detected",
            session_id=session_id,
            message_id=message_id,
            finish=finish_text,
            age=age,
        )
        age_text = f", последнее сообщение {age} с назад" if age is not None else ""
        return f"OpenCode остановился без финального текстового отчёта (finish {finish_text}{age_text})"
    except Exception as exc:
        log("missing_final_report_check_error", session_id=session_id, error=str(exc))
        return None


def recent_descendant_count(session_id, since_ms):
    try:
        conn = sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True, timeout=1)
        conn.execute("pragma query_only=ON")
        query = """
        with recursive tree(id) as (
          values(?)
          union
          select s.id from session s join tree t on s.parent_id = t.id
        )
        select count(*)
        from session s
        join tree t on t.id = s.id
        where s.id != ?
          and s.time_updated >= ?
        """
        row = conn.execute(query, (session_id, session_id, since_ms)).fetchone()
        conn.close()
        return int(row[0] or 0) if row else 0
    except Exception as exc:
        log("db_children_error", session_id=session_id, error=str(exc))
        return 0


def send_tool_call(session_id, active, title=None):
    update = {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
            "sessionId": session_id,
            "update": {
                "sessionUpdate": "tool_call",
                "toolCallId": "opencode-acp-watch-status",
                "title": title or f"OpenCode активен: выполняются инструменты ({active})",
                "kind": "other",
                "status": "in_progress",
                "content": [],
            },
        },
    }
    write_json(update)


def send_tool_call_update(session_id, status, title):
    update = {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
            "sessionId": session_id,
            "update": {
                "sessionUpdate": "tool_call_update",
                "toolCallId": "opencode-acp-watch-status",
                "title": title,
                "status": status,
            },
        },
    }
    write_json(update)


def hold_response_until_idle(raw, response_id, session_id, prompt_start_ms):
    started = time.monotonic()
    sent_status = False
    prompt_age = max(0.0, (now_ms() - prompt_start_ms) / 1000) if prompt_start_ms else 0.0
    child_cutoff = prompt_start_ms or (now_ms() - ACTIVE_WINDOW_SEC * 1000)
    recent_children = recent_descendant_count(session_id, child_cutoff)
    grace_sec = IDLE_GRACE_SEC
    if recent_children > 0 or prompt_age >= COMPLEX_PROMPT_SEC:
        grace_sec = max(grace_sec, LATE_GRACE_SEC)
    log(
        "hold_begin",
        response_id=response_id,
        session_id=session_id,
        prompt_age=round(prompt_age, 2),
        recent_children=recent_children,
        grace_sec=grace_sec,
    )

    last_heartbeat = 0.0
    while not shutdown.is_set():
        if session_id in cancelled_sessions:
            log("hold_release_cancelled", response_id=response_id, session_id=session_id)
            break

        elapsed = time.monotonic() - started
        active = active_descendant_count(session_id)
        if active <= 0 and elapsed >= grace_sec:
            log("hold_release_idle", response_id=response_id, session_id=session_id, elapsed=round(elapsed, 2))
            break
        if elapsed >= MAX_HOLD_SEC:
            log("hold_release_timeout", response_id=response_id, session_id=session_id, active=active, elapsed=round(elapsed, 2))
            break

        now = time.monotonic()
        if active > 0 and now - last_heartbeat >= max(2.0, POLL_SEC * 2):
            last_heartbeat = now
            if sent_status:
                send_tool_call_update(session_id, "in_progress", f"OpenCode активен: фоновые агенты выполняются ({active})")
            else:
                send_tool_call(session_id, active)
                sent_status = True
            log("hold_heartbeat", response_id=response_id, session_id=session_id, active=active, elapsed=round(elapsed, 2))
        time.sleep(POLL_SEC)

    if sent_status:
        send_tool_call_update(session_id, "completed", "OpenCode: фоновые агенты завершили активность")
    write_line(raw)


def status_monitor_until_idle(session_id, prompt_start_ms, initial_status_sent=False, preflight_sample=None):
    started = time.monotonic()
    sent_status = bool(initial_status_sent)
    status_announced = bool(initial_status_sent)
    saw_activity = False
    eta_recorded = False
    quiet_since = None
    last_heartbeat = 0.0
    last_reannounce = time.monotonic() if initial_status_sent else 0.0
    exit_reason = "shutdown"
    log(
        "status_monitor_begin",
        session_id=session_id,
        prompt_start_ms=prompt_start_ms,
        initial_status_sent=initial_status_sent,
    )

    try:
        while not shutdown.is_set():
            elapsed = time.monotonic() - started
            summary = descendant_activity_summary(session_id)
            active = int(summary.get("active", 0))
            recent = int(summary.get("recent", 0))
            has_activity = active > 0 or recent > 0
            now = time.monotonic()

            if session_id in cancelled_sessions:
                cancel_ms = cancelled_session_ms.get(session_id) or now_ms()
                cancel_age_sec = max(0.0, (now_ms() - cancel_ms) / 1000)
                latest_activity_updated = int(summary.get("latest_activity_updated") or 0)
                continuation_cutoff = cancel_ms + int(CANCEL_GRACE_SEC * 1000)
                continued_after_cancel = latest_activity_updated >= continuation_cutoff

                if has_activity:
                    saw_activity = True

                if not continued_after_cancel and cancel_age_sec < CANCEL_GRACE_SEC:
                    if now - last_heartbeat >= max(2.0, POLL_SEC * 2):
                        last_heartbeat = now
                        remaining = max(0, int(CANCEL_GRACE_SEC - cancel_age_sec))
                        title = f"OpenCode: проверяю продолжение работы после отмены ({remaining} с)"
                        if sent_status or status_announced:
                            send_tool_call_update(session_id, "in_progress", title)
                        else:
                            send_tool_call(session_id, active, title)
                            status_announced = True
                        sent_status = True
                        log(
                            "status_monitor_cancel_grace",
                            session_id=session_id,
                            active=active,
                            recent=recent,
                            cancel_age=round(cancel_age_sec, 2),
                            latest_activity_updated=latest_activity_updated,
                        )
                    time.sleep(POLL_SEC)
                    continue

                if continued_after_cancel:
                    cancelled_sessions.discard(session_id)
                    cancelled_session_ms.pop(session_id, None)
                    quiet_since = None
                    title = "OpenCode продолжает работу после отмены/reconnect"
                    if now - last_heartbeat >= max(2.0, POLL_SEC * 2):
                        last_heartbeat = now
                        if sent_status or status_announced:
                            send_tool_call_update(session_id, "in_progress", title)
                        else:
                            send_tool_call(session_id, active, title)
                            status_announced = True
                        sent_status = True
                    log(
                        "status_monitor_cancel_ignored_active",
                        session_id=session_id,
                        active=active,
                        recent=recent,
                        cancel_age=round(cancel_age_sec, 2),
                        latest_activity_updated=latest_activity_updated,
                    )
                else:
                    exit_reason = "cancelled"
                    log(
                        "status_monitor_cancelled",
                        session_id=session_id,
                        cancel_age=round(cancel_age_sec, 2),
                        active=active,
                        recent=recent,
                    )
                    break

            if has_activity:
                saw_activity = True
                quiet_since = None
                if now - last_heartbeat >= max(2.0, POLL_SEC * 2):
                    last_heartbeat = now
                    title = activity_title(summary)
                    reannounce = (
                        STATUS_REANNOUNCE_SEC > 0
                        and sent_status
                        and now - last_reannounce >= STATUS_REANNOUNCE_SEC
                    )
                    if reannounce:
                        send_tool_call(session_id, active, title)
                        last_reannounce = now
                        sent_status = True
                        status_announced = True
                    elif sent_status:
                        send_tool_call_update(session_id, "in_progress", title)
                    elif status_announced:
                        send_tool_call_update(session_id, "in_progress", title)
                        sent_status = True
                    else:
                        send_tool_call(session_id, active, title)
                        last_reannounce = now
                        sent_status = True
                        status_announced = True
                    log(
                        "status_monitor_heartbeat",
                        session_id=session_id,
                        active=active,
                        recent=recent,
                        latest_title=summary.get("latest_title", ""),
                        latest_age=summary.get("latest_age"),
                        elapsed=round(elapsed, 2),
                        reannounce=reannounce,
                    )
            else:
                if quiet_since is None:
                    quiet_since = now
                idle_elapsed = now - quiet_since
                if sent_status and saw_activity and idle_elapsed >= IDLE_GRACE_SEC:
                    idle_title = missing_final_report_title(session_id, prompt_start_ms)
                    actual_elapsed = max(0.0, (now_ms() - prompt_start_ms) / 1000) if prompt_start_ms else elapsed
                    log(
                        "status_monitor_idle",
                        session_id=session_id,
                        elapsed=round(elapsed, 2),
                        missing_final_report=bool(idle_title),
                    )
                    final_status = "failed" if idle_title else "completed"
                    final_title = idle_title or "OpenCode: активные инструменты завершили работу"
                    final_outcome = "missing_final_report" if idle_title else "completed"
                    send_tool_call_update(session_id, final_status, final_title)
                    write_eta_stats(
                        preflight_sample,
                        final_outcome,
                        actual_elapsed,
                        saw_activity,
                        {"missing_final_report": bool(idle_title)},
                    )
                    eta_recorded = True
                    sent_status = False
                    quiet_since = None
                    exit_reason = "completed"
                    break

            if elapsed >= STATUS_MONITOR_MAX_SEC:
                if has_activity:
                    log(
                        "status_monitor_extended",
                        session_id=session_id,
                        active=active,
                        recent=recent,
                        elapsed=round(elapsed, 2),
                    )
                    started = time.monotonic()
                    quiet_since = None
                else:
                    exit_reason = "timeout"
                    log(
                        "status_monitor_timeout",
                        session_id=session_id,
                        active=active,
                        recent=recent,
                        elapsed=round(elapsed, 2),
                    )
                    break

            if sent_status or elapsed < STATUS_START_GRACE_SEC:
                time.sleep(POLL_SEC)
            else:
                time.sleep(max(POLL_SEC, STATUS_IDLE_POLL_SEC))
    finally:
        if not eta_recorded and preflight_sample:
            actual_elapsed = max(0.0, (now_ms() - prompt_start_ms) / 1000) if prompt_start_ms else time.monotonic() - started
            write_eta_stats(preflight_sample, exit_reason, actual_elapsed, saw_activity)
        if sent_status:
            if exit_reason == "cancelled":
                send_tool_call_update(session_id, "failed", "OpenCode: запрос отменён")
            elif exit_reason == "timeout":
                send_tool_call_update(session_id, "failed", "OpenCode: истёк таймаут мониторинга статуса")
            else:
                send_tool_call_update(session_id, "failed", "OpenCode: мониторинг статуса остановлен")
            log("status_monitor_closed_failed", session_id=session_id, reason=exit_reason)
        with status_lock:
            status_sessions.discard(session_id)


def start_status_monitor(session_id, prompt_start_ms):
    with status_lock:
        if session_id in status_sessions:
            return False
        status_sessions.add(session_id)
    preflight_sample = send_preflight_status(session_id, prompt_start_ms)
    initial_status_sent = bool(preflight_sample)
    thread = threading.Thread(
        target=status_monitor_until_idle,
        args=(session_id, prompt_start_ms, initial_status_sent, preflight_sample),
        daemon=True,
        name=f"status-{session_id}",
    )
    thread.start()
    return True


def forward_client_to_agent(agent):
    for raw in sys.stdin.buffer:
        message = parse_line(raw)
        if message:
            rid = request_id(message)
            method = method_name(message)
            if method == "session/prompt" and rid is not None:
                session_id = extract_session_id_from_prompt(message)
                if session_id:
                    cancelled_sessions.discard(session_id)
                    cancelled_session_ms.pop(session_id, None)
                    prompt_start_ms = now_ms()
                    pending_prompt_by_id[rid] = {
                        "session_id": session_id,
                        "start_ms": prompt_start_ms,
                    }
                    if not HOLD_RESPONSES:
                        start_status_monitor(session_id, prompt_start_ms)
                    log("prompt_request", request_id=rid, session_id=session_id)
            elif method in ("session/cancel", "session/stop"):
                session_id = extract_session_id_from_cancel(message)
                if session_id:
                    cancelled_sessions.add(session_id)
                    cancelled_session_ms[session_id] = now_ms()
                    log("cancel_request", session_id=session_id)
            else:
                log("client_message", request_id=rid, method=method)
        try:
            agent.stdin.write(raw)
            if not raw.endswith(b"\n"):
                agent.stdin.write(b"\n")
            agent.stdin.flush()
        except BrokenPipeError:
            break
    try:
        agent.stdin.close()
    except Exception:
        pass


def forward_agent_to_client(agent):
    for raw in agent.stdout:
        message = parse_line(raw)
        if not message:
            write_line(raw)
            continue

        rid = request_id(message)
        prompt = pending_prompt_by_id.pop(rid, None) if rid is not None else None
        session_id = prompt.get("session_id") if isinstance(prompt, dict) else prompt
        prompt_start_ms = prompt.get("start_ms") if isinstance(prompt, dict) else None
        if HOLD_RESPONSES and session_id and "result" in message:
            thread = threading.Thread(
                target=hold_response_until_idle,
                args=(raw, rid, session_id, prompt_start_ms),
                daemon=False,
                name=f"hold-{rid}",
            )
            held_threads.append(thread)
            thread.start()
            continue

        write_line(raw)
    shutdown.set()


def forward_stderr(agent):
    for raw in agent.stderr:
        try:
            sys.stderr.buffer.write(raw)
            sys.stderr.buffer.flush()
        except Exception:
            break


def main():
    log("wrapper_start", real_opencode=REAL_OPENCODE, db=DB_PATH, hold=HOLD_RESPONSES)
    start_lock = acquire_start_lock()
    agent = subprocess.Popen(
        [REAL_OPENCODE, "acp"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        bufsize=0,
    )

    threads = [
        threading.Thread(target=forward_client_to_agent, args=(agent,), daemon=True, name="stdin"),
        threading.Thread(target=forward_agent_to_client, args=(agent,), daemon=True, name="stdout"),
        threading.Thread(target=forward_stderr, args=(agent,), daemon=True, name="stderr"),
    ]
    for thread in threads:
        thread.start()

    if start_lock:
        hold_until = time.monotonic() + max(0.0, START_LOCK_HOLD_SEC)
        while time.monotonic() < hold_until:
            if agent.poll() is not None:
                break
            time.sleep(0.1)
        release_start_lock(start_lock)

    while not shutdown.is_set():
        if agent.poll() is not None:
            shutdown.set()
            break
        time.sleep(0.2)

    for thread in held_threads:
        thread.join(timeout=MAX_HOLD_SEC + 10)

    if agent.poll() is None:
        try:
            agent.terminate()
            agent.wait(timeout=5)
        except Exception:
            try:
                agent.kill()
            except Exception:
                pass
    code = agent.poll()
    log("wrapper_stop", exit_code=code)
    return 0 if code is None else code


if __name__ == "__main__":
    os._exit(main())
